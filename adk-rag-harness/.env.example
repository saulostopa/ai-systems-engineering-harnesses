# adk-rag-harness settings. Copy to .env (ignored by Git) and uncomment what
# you change; every line below shows the default. `uv run adk web` loads .env,
# and variables already set in the shell win over it.
#
# Names follow HARNESS_<ROLE>_<SETTING> for the three roles: chat (the model
# that talks to you), decision (Jev's typed routing) and embed (RAG vectors).
# Never put keys here: they come from OPENROUTER_API_KEY / TYPESAFE_API_KEY in
# the environment or from ~/.local/share/opencode/auth.json.

# ── Conversation model ──────────────────────────────────────────────
# HARNESS_CHAT_PROVIDER=openrouter        # openrouter | ollama
# HARNESS_CHAT_MODEL=typesafe/jev-router  # ollama default: llama3.1:8b

# ── Typed decisions (Jev) ───────────────────────────────────────────
# HARNESS_DECISION_PROVIDER=openrouter        # openrouter | ollama | typesafe | demo
# HARNESS_DECISION_MODEL=typesafe/jev-router  # ollama: qwen2.5:14b · typesafe: jev-latest

# ── Embeddings (must match the ones used to build the index) ────────
# HARNESS_EMBED_PROVIDER=                       # openrouter | ollama | ngram; empty: Ollama if reachable, else ngram
# HARNESS_EMBED_MODEL=voyageai/voyage-code-4    # with openrouter · ollama default: nomic-embed-text

# ── Retrieval ───────────────────────────────────────────────────────
# HARNESS_RAG_PROVIDER=demo   # demo | index
# Per-project paths belong in the project's launcher (e.g. npm run assistente),
# not here, so several projects work without editing this file:
# HARNESS_RAG_DOCS_INDEX=/path/to/repo/.rag_index/docs
# HARNESS_RAG_CODE_INDEX=/path/to/repo/.rag_index/code
# HARNESS_RAG_AREA_INDEX=/path/to/area/.rag_index
# HARNESS_PROJECT_ROOT=/path/to/repo

# ── Guardrail ───────────────────────────────────────────────────────
# HARNESS_GUARDRAIL=off   # on: Jev blocks prompt injection before retrieval

# ── Token and cost ledger (harness-usage) ───────────────────────────
# HARNESS_BUDGET_USD=25   # monthly warning at 80% and 100%; 0 disables
# HARNESS_USAGE=1         # 0 turns recording off
# HARNESS_USAGE_DIR=      # replaces <project>/.harness/usage

# ── Service endpoints ───────────────────────────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://localhost:11434
# OPENROUTER_AUTH_FILE=~/.local/share/opencode/auth.json
